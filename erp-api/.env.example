NODE_ENV=development
PORT=3052

FIREBIRD_HOST=127.0.0.1
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=C:/CAMINHO/ERP.FDB
FIREBIRD_USER=
FIREBIRD_PASSWORD=
FIREBIRD_ROLE=
FIREBIRD_PAGE_SIZE=4096
FIREBIRD_CHARSET=WIN1252

API_KEY=
HMAC_SECRET=

CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOG_LEVEL=info

DEV_BYPASS_AUTH=false

# Idempotência (POST /api/v1/orders). Em produção use "file".
IDEMPOTENCY_STORE=file
IDEMPOTENCY_FILE_PATH=./data/idempotency.json
IDEMPOTENCY_TTL_HOURS=24

# ── Geocoding (POST /api/v1/map/geocode) ──────────────────────────────
# "fake"   → resolvedor determinístico local (dev/testes, sem custo).
#            Proibido em NODE_ENV=production (falha no boot).
# "google" → Google Geocoding API. Exige GOOGLE_GEOCODING_API_KEY.
#            Sem chave o boot falha (não há fallback silencioso para fake).
GEOCODING_PROVIDER=fake
GOOGLE_GEOCODING_API_KEY=
GEOCODING_MAX_PER_REQUEST=25
GEOCODING_GLOBAL_TIMEOUT_MS=8000
GEOCODING_PROVIDER_TIMEOUT_MS=4000
# Cache atualmente é in-memory por processo. Exige PM2 em FORK MODE com
# instances=1. Em CLUSTER MODE cada worker tem seu próprio cache e o GET
# pode não enxergar o que o POST gravou em outro worker. Reiniciar o
# processo apaga todas as coordenadas resolvidas.
GEOCODING_PERSIST_COORDS=false
GEOCODING_INFLIGHT_TTL_MS=60000